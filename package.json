{
  "name": "memo-works",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production && node scripts/inject-preload.js ./dist/MemoWorks/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "build:es": "ng build --configuration=es",
    "build:en": "ng build --configuration=en",
    "build:locales": "ng build --localize",
    "postbuild": "node scripts/inject-preload.js ./dist/MemoWorks/browser"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/localize": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fullcalendar/angular": "^6.1.19",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "dotenv": "^17.2.3",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.2.4",
    "@angular/compiler-cli": "^21.0.0",
    "@types/dotenv": "^6.1.1",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  }
}
